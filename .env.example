# Copy this file to .env and replace the placeholder secrets before running.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# POSTGRES_DB is the ANALYTICS database (the one Metabase reads).
# AIRFLOW_DB is a SEPARATE database on the same server for Airflow's own
# metadata tables, so Airflow internals never show up in Metabase.
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=ecommerce_db
AIRFLOW_DB=airflow_db
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# MinIO (raw object storage)
# ---------------------------------------------------------------------------
# Keep these alphanumeric: they are embedded in a URI for the Airflow
# connection below, and characters like @ : / would break the parsing.
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_RAW_BUCKET=ecommerce-raw
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_HOST_PORT=8080

# FERNET_KEY encrypts stored connection passwords; SECRET_KEY signs UI sessions.
# Both must stay stable across restarts or saved connections become unreadable.
# Generate replacements with:
#   openssl rand -base64 32 | tr '+/' '-_'   # AIRFLOW_FERNET_KEY
#   openssl rand -hex 32                     # AIRFLOW_SECRET_KEY
AIRFLOW_FERNET_KEY=generate_me
AIRFLOW_SECRET_KEY=generate_me

# Owner UID for the mounted dags/ and logs/ directories. On Linux and in CI set
# this to your own UID (`id -u`) or Airflow cannot write logs. 50000 is the
# airflow user baked into the image and is the right default on Docker Desktop.
AIRFLOW_UID=50000

# ---------------------------------------------------------------------------
# Metabase
# ---------------------------------------------------------------------------
METABASE_HOST_PORT=3000

# Metabase rejects weak passwords: at least 8 characters, mixed case and a digit.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change_me_Metabase1
